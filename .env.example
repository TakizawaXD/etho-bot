# ==========================================================
# ETHO MULTI-BOT HUB — CONFIGURACIÓN DE PRODUCCIÓN (.env)
# Copia este archivo como .env y completa tus credenciales.
# ==========================================================

# --- Servidor Web & Seguridad del Panel ---
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# Clave para firmar sesiones (32+ caracteres aleatorios). Si se deja vacía se genera una
# automáticamente en data/.auth_secret. Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Orígenes CORS permitidos, separados por coma (opcional; vacío = abierto como antes)
CORS_ORIGIN=

# Credenciales del Administrador inicial (se crean en el primer arranque)
ADMIN_USERNAME=admin
# Si se deja vacía, se genera una contraseña aleatoria y se muestra en consola en el primer arranque
ADMIN_PASSWORD=

# --- Configuración Global del Bot ---
BOT_NAME=Etho
PREFIX=#
# Números dueños globales (sin +, separados por coma). Ej: 573001112233,521234567890
OWNER_NUMBERS=
CURRENCY=coins
# Opcional: número para vinculación inicial por código de 8 dígitos (sin +)
PAIRING_NUMBER=

# --- Almacenamiento Persistente (Montar volumen en /app/data en Docker/Cloud) ---
DB_PATH=./data/bot.db
SESSION_DIR=./data/sessions

# --- Motores de Inteligencia Artificial (Atención al Cliente & Asesor) ---
# Recomendado para máxima calidad y velocidad (Google AI Studio):
GEMINI_API_KEY=
# Opcional (respaldo / transcripción de notas de voz con Whisper):
HF_TOKEN=
HF_MODEL=HuggingFaceH4/zephyr-7b-beta

# --- Espejo en la Nube con Supabase (Opcional — ver supabase/schema.sql) ---
SUPABASE_URL=
SUPABASE_KEY=

# ======================================================
# PLANES, LÍMITES Y PAGOS
# ======================================================
# Cuenta gratuita: días de prueba y máximo de bots (por defecto 7 y 3)
TRIAL_DAYS=7
FREE_MAX_BOTS=3
# Moneda de cobro (código ISO de 3 letras, minúsculas o mayúsculas)
PAYMENT_CURRENCY=usd
# Ajustar planes sin tocar código (opcional). Ej: {"pro":{"priceCents":1999,"maxBots":5},"vip":{"days":120}}
PLANS_JSON=
# URL pública del sitio (obligatoria para pagos con tarjeta): https://tu-dominio.com
PUBLIC_URL=

# --- Pago con tarjeta (Stripe Checkout) ---
# Crea el webhook en Stripe apuntando a: PUBLIC_URL/api/payments/stripe/webhook
# con los eventos: checkout.session.completed, checkout.session.async_payment_succeeded,
#                  checkout.session.async_payment_failed, checkout.session.expired
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Pago por transferencia (se aprueba manualmente en el panel de administración) ---
# Datos bancarios que verá el cliente. Usa \n para saltos de línea.
TRANSFER_INSTRUCTIONS=

# ======================================================
# ESCALABILIDAD Y RESILIENCIA
# ======================================================
# Máximo de bots conectados a la vez en este servidor (cada uno usa ~60-100 MB de RAM)
MAX_ONLINE_BOTS=30
# Pausa entre el encendido de cada bot al arrancar (ms) para evitar picos
BOOT_STAGGER_MS=1500
# Retención de datos (días) y copias de seguridad automáticas diarias en data/backups
LOG_RETENTION_DAYS=30
CHAT_RETENTION_DAYS=60
BACKUP_KEEP=7
# Límites anti-abuso
API_RATE_LIMIT_PER_MIN=600
REGISTER_LIMIT_PER_DAY=5
TICKETS_PER_HOUR=5

# ======================================================
# ALERTAS (opcional)
# ======================================================
# Webhook https (Slack, Discord, Make, n8n...) que recibe avisos graves: excepciones no controladas,
# pagos inconsistentes, fallos del webhook de Stripe y de las copias de seguridad.
ALERT_WEBHOOK_URL=
ALERT_SERVICE_NAME=Etho Hub

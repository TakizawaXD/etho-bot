# ==========================================================
# ETHO MULTI-BOT HUB — CONFIGURACIÓN DE PRODUCCIÓN (.env)
# Copia este archivo como .env y completa tus credenciales.
# ==========================================================

# --- Servidor Web & Seguridad del Panel ---
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# Cambia esta clave secreta en producción (ej: cadena aleatoria de 32+ caracteres)
AUTH_SECRET=cambia_esta_clave_secreta_en_produccion_2026

# Credenciales del Administrador inicial (se crean en el primer arranque)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# --- Configuración Global del Bot ---
BOT_NAME=Etho
PREFIX=#
# Números dueños globales (sin +, separados por coma). Ej: 573001112233,521234567890
OWNER_NUMBERS=
CURRENCY=coins
# Opcional: número para vinculación inicial por código de 8 dígitos (sin +)
PAIRING_NUMBER=

# --- Almacenamiento Persistente (Montar volumen en /app/data en Docker/Cloud) ---
DB_PATH=./data/bot.db
SESSION_DIR=./data/sessions

# --- Motores de Inteligencia Artificial (Atención al Cliente & Asesor) ---
# Recomendado para máxima calidad y velocidad (Google AI Studio):
GEMINI_API_KEY=
# Opcional (respaldo / transcripción de notas de voz con Whisper):
HF_TOKEN=
HF_MODEL=HuggingFaceH4/zephyr-7b-beta

# --- Espejo en la Nube con Supabase (Opcional — ver supabase/schema.sql) ---
SUPABASE_URL=
SUPABASE_KEY=

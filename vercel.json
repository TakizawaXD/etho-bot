{
  "version": 2,
  "cleanUrls": true,
  "installCommand": "echo \"Sin instalación: solo se publica la web estática\"",
  "buildCommand": "echo \"Sin build\"",
  "outputDirectory": "src/web/public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://TU-BACKEND.example.com/api/:path*" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] }
  ]
}
